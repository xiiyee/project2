+const setMobileMenuState = (nextState: boolean): void => {
+  if (mobileMenuTransitioning.value) {
+    pendingMobileMenuState.value = nextState;
+    return;
+  }
+
+  pendingMobileMenuState.value = null;
+  mobileMenuOpen.value = nextState;
